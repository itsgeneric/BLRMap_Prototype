# ── Spatial Data & Assets (Heavy Files) ──
# You generally do not want to push 100MB+ graphml or geojson files to GitHub.
# If you need to track specific small files, you can force them with `git add -f`
Data Assets/*.graphml
Data Assets/*.geojson
*.osm
*.pbf

# ── OSMnx / API Cache ──
# OSMnx caches map downloads locally to speed up restarts. This should not be tracked.
cache/

# ── Databases & Logs ──
# Ignores your SQLite DB and the Write-Ahead Logging temporary files we enabled
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
route_decisions.db
*.log

# ── IDEs & Tooling ──
.vscode/
.idea/
*.swp
*.swo

# ── OS Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db