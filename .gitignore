# ── Environment & Secrets ──
.env
.venv/
venv/
env/

# ── Python Internals ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
