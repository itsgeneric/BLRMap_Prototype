# Copy to frontend/.env.local and fill in real values. Never commit the real file.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_STADIA_KEY=
# Backend address; set to your PC's LAN IP to use the app on a phone, e.g. http://192.168.0.180:8000
NEXT_PUBLIC_API_BASE=
# Redraw routes on Google's road geometry with the Roads API (enable it for the key). 0 = off
NEXT_PUBLIC_SNAP_ROUTES=1
